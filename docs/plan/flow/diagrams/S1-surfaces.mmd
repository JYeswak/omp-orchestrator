flowchart TD
  S1["S1 surfaces. kind=tool. Invariant PROJECTED: after L0, command -v ompo first executable is dest or prior, never a third hit. Today installer verifies a supplied absolute path."]

  S1 --> L0
  S1 --> L1
  S1 --> L4
  S1 --> L5

  L0["L0 install"] --> L0OMP["OMP: none on purpose. Pre-session. omp-rpc-session Command::new omp at lib.rs:136 is the later child, not the installer"]
  L0 --> L0NTM["NTM: none. No pane yet"]
  L0 --> L0CX["Asupersync: subprocess-contract::run_output and Cx, process group kill, drain both pipes. Installer std::process is the current caller to replace"]

  L1["L1 doctor"] --> L1OMP["OMP: RpcRequest::GetState get_session_stats via omp-rpc-session for OMP children only. omp/18.1.6 --mode=rpc"]
  L1 --> L1NTM["NTM: ntm --robot-snapshot v1.31.0 session presence"]
  L1 --> L1CX["Asupersync: every probe bounded through run_output. Timeout is RunError::Timeout not a subject verdict. tmux -V not --version"]

  L4["L4 swarm"] --> L4OMP["OMP: GetState plus GetSessionStats on each OMP pane. Not a spinner regex"]
  L4 --> L4NTM["NTM: ntm spawn --assign --cass-context. WAVE.md from tmux list-panes. Retain spawn response, pane id, WAVE hash, mail register, pack receipt"]
  L4 --> L4CX["Asupersync: spawn ntm through subprocess-contract and Cx. Same group-kill contract as installer"]

  L5["L5 portal"] --> L5OMP["OMP: GetState plus GetSessionStats. Does not replace NTM or Agent Mail"]
  L5 --> L5NTM["NTM: snapshot plus bv queue as one_next_action input"]
  L5 --> L5CX["Asupersync: portal observe uses Cx checkpoint. No detached poll"]
